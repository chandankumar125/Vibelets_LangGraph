# REQUIRED: OpenAI API Key (for GPT-4 agents)
OPENAI_API_KEY=your_openai_api_key_here

# OPTIONAL: Google AI API Key (for Gemini-based image generation)
GOOGLE_API_KEY=your_google_api_key_here

# REQUIRED: HeyGen API Configuration
HEYGEN_API_KEY=your_heygen_api_key_here

# REQUIRED: ElevenLabs API Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OPTIONAL: Pixlr API Configuration
PIXLR_API_KEY=your_pixlr_api_key_here

# OPTIONAL: Facebook API Configuration
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
